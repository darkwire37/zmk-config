#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
                        bindings = <
   &kp ESC   &kp N1     &kp N2   &kp N3   &kp N4        &kp N5     &kp N6       &kp N7  &kp N8          &kp N9          &kp N0    &kp BSLH
   &kp TAB   &kp Q      &kp W   &kp E   &kp R   &kp T          &kp Y    &kp U    &kp I     &kp O   &kp P    &kp BSPC
   &kp CAPS  &kp A      &kp S   &kp D   &kp F   &kp G          &kp H    &kp J    &kp K     &kp L   &kp COLON      &kp ENTER
   &kp LSHFT            &kp Z   &kp X   &kp C   &kp V          &kp B    &kp N   &kp M   &kp COMMA       &kp DOT         &kp RSHIFT
   &kp LCTRL    &mo 1   &kp LGUI    &kp SPACE                  &kp SPACE    &kp RCTRL   &kp RALT   &mo 2
                        >;
                };
                lower_layer {
                        display-name = "Arrowkey Layer";
                        bindings = <
   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSLH
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T          &kp Y &kp U  &kp I     &kp UP   &kp P    &kp BSPC
   &kp CAPS  &kp A &kp S &kp D &kp F &kp G          &kp H &kp J  &kp LEFT     &kp DOWN   &kp RIGHT &kp ENTER
   &kp LSHFT       &kp Z &kp X &kp C &kp V          &kp B &kp N &kp M  &kp COMMA &kp DOT &kp RSHIFT
   &kp LCTRL &mo 1 &kp LGUI    &kp SPACE                  &kp SPACE    &kp RCTRL &mo 2   &mo 3
                        >;
                };

                raise_layer {
                        display-name = "Raise Layer";
                        bindings = <
   &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5     &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSLH
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T          &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp CAPS  &kp A &kp S &kp D &kp F &kp G          &kp H &kp J  &kp K     &kp L   &kp COLON &kp ENTER
   &kp LSHFT       &kp Z &kp X &kp C &kp V          &kp B &kp N &kp M  &kp COMMA &kp DOT &kp RSHIFT
   &kp LCTRL &mo 1 &kp LGUI    &kp SPACE                  &kp SPACE    &kp RCTRL &mo 2   &mo 3
                        >;
                };
        };
};